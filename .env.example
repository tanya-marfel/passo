# Copy to .env.local and fill in what you have: cp .env.example .env.local
# Every key is optional: without them the coach runs on the built-in rule engine and the browser does the talking.

# Gemini, the coach brain. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override, e.g. gemini-2.5-flash. Leave empty to use the newest Gemini Flash.
GEMINI_MODEL=

# Gradium, the coach voice and speech-to-text. Use the API key from your Gradium account.
GRADIUM_API_KEY=
# Optional voice override. Leave empty for the flagship voice "Russell" (_6Aslh2DxfmnRLmP).
GRADIUM_VOICE_ID=

# Garmin Connect sign-in. Create an app at https://developerportal.garmin.com/
# Redirect URI: http://localhost:4590/api/garmin/callback
# Activity webhook: https://YOUR_PUBLIC_HOST/api/garmin/webhook
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
# Optional. Defaults to this site's /api/garmin/callback and must match the portal exactly.
GARMIN_REDIRECT_URI=
# Optional. If set, Garmin must call /api/garmin/webhook?token=THIS_VALUE
GARMIN_WEBHOOK_TOKEN=
